    {
      "id": "sql-structured-candidate-prefilter",
      "name": "SQL structured candidate prefilter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        920,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidates AS (SELECT * FROM (\nSELECT u.id AS user_id, p.id AS product_id,\n p.criteria_complete, p.verification_status,\n p.lender, p.product_name, p.source_url, p.rate_representation, p.retrieved_at,\n c.minimum_monthly_income, c.minimum_credit_score, c.age_min, c.age_max,\n c.employment_requirements, c.qualitative_requirements\nFROM users u JOIN loan_products p ON p.active = true\nJOIN product_criteria c ON c.product_id = p.id\nWHERE u.job_id = $1\n AND (p.verification_status = 'VERIFIED' OR ($2 AND p.verification_status = 'DEMO_FIXTURE'))\n AND (c.minimum_monthly_income IS NULL OR u.monthly_income >= c.minimum_monthly_income)\n AND (c.minimum_credit_score IS NULL OR u.credit_score >= c.minimum_credit_score)\n AND (c.age_min IS NULL OR u.age >= c.age_min)\n AND (c.age_max IS NULL OR u.age <= c.age_max)\n AND (c.employment_requirements IS NULL OR CAST(c.employment_requirements AS jsonb) = 'null'::jsonb OR CAST(c.employment_requirements AS jsonb) ? u.employment_status)\n) AS eligible WHERE (user_id,product_id) > ($3,$4) ORDER BY user_id,product_id LIMIT $5) SELECT $1::text AS job_id, $3::bigint AS after_user_id, $4::integer AS after_product_id, COALESCE(jsonb_agg(to_jsonb(candidates) ORDER BY user_id,product_id), '[]'::jsonb) AS candidates FROM candidates",
        "options": {
          "queryReplacement": "={{[$json.job_id, $env.DEMO_MODE === 'true', $json.after_user_id, $json.after_product_id, $json.page_size]}}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "loan-domain-postgres",
          "name": "Loan domain PostgreSQL"
        }
      }
    },
    {
      "id": "advanced-deterministic-rules",
      "name": "Advanced deterministic rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        0
      ],
      "parameters": {
        "jsCode": "const envelope = $json;\nconst fields = ['minimum_monthly_income','minimum_credit_score','age_min','age_max','employment_requirements'];\nif (!Array.isArray(envelope.candidates) || envelope.candidates.length > 1000) {\n  throw new Error('Candidate page exceeds 1000 rows');\n}\nconst evaluations = envelope.candidates.map(candidate => {\n  const unknown = fields.filter(field => candidate[field] === null);\n  unknown.push(...(candidate.qualitative_requirements || []));\n  if (!candidate.criteria_complete) unknown.push('Incomplete source criteria');\n  return {user_id:candidate.user_id, product_id:candidate.product_id,\n    status:unknown.length ? 'REVIEW_REQUIRED' : 'POSSIBLY_ELIGIBLE'};\n});\nreturn [{json:{job_id:envelope.job_id, after_user_id:envelope.after_user_id ?? 0,\n  after_product_id:envelope.after_product_id ?? 0, evaluations}}];\n"
      }
    },
