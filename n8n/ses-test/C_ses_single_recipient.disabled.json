  "active": false,
  "nodes": [
    {
      "id": "manual-ses-preparation",
      "name": "Manual controlled test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "pinned-approved-test-job",
      "name": "Pinned approved test job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ],
      "parameters": {
        "jsCode": "const plan = {\"phase\":\"PREPARATION_ONLY\",\"approved\":false,\"region\":\"ap-south-1\",\"account_id\":null,\"sender\":null,\"recipient\":null,\"job_id\":null,\"max_messages\":1,\"credential_installed\":false,\"sender_verified_in_region\":false,\"recipient_verified_in_region\":false,\"sandbox_status\":\"UNVERIFIED\",\"production_workflow_change_allowed\":false};\nif(plan.approved!==true)throw new Error('SES send approval is absent; preparation only');if(plan.region!=='ap-south-1'||!['SANDBOX','PRODUCTION'].includes(plan.sandbox_status))throw new Error('Confirm region and sandbox status');if(plan.max_messages!==1||!plan.credential_installed||!plan.sender_verified_in_region||!plan.recipient_verified_in_region)throw new Error('SES preparation prerequisites incomplete');if(!/^[0-9]{12}$/.test(plan.account_id||'')||!/^[-0-9a-f]{36}$/.test(plan.job_id||''))throw new Error('Pin one account and one job');for(const field of ['sender','recipient'])if(typeof plan[field]!=='string'||!/^([^\\s@,;<>]+)@([^\\s@,;<>]+)$/.test(plan[field]))throw new Error('Pin one exact sender and recipient');return [{json:{job_id:plan.job_id,sender:plan.sender,recipient:plan.recipient,region:plan.region}}];"
      }
    },
    {
      "id": "fetch-single-user-job",
      "name": "Fetch single-user job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "url": "=http://ses-test-api:8000/internal/jobs/{{$json.job_id}}",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "loan-internal-header",
          "name": "Loan internal header"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "require-one-completed-synthetic-user",
      "name": "Require one completed synthetic user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        0
      ],
      "parameters": {
        "jsCode": "const plan=$('Pinned approved test job').first().json;if($json.id!==plan.job_id||$json.status!=='COMPLETED'||$json.accepted!==1||$json.rejected!==0)throw new Error('Expected one completed single-user job');return [{json:{job_id:plan.job_id}}];"
      }
    },
    {
      "id": "select-delivery-transport",
