      "parameters": {
        "jsCode": "const plan=$('Pinned approved test job').first().json;if($json.ready!==true||$json.job_id!==plan.job_id||$json.to!==plan.recipient||$json.from!==plan.sender||typeof $json.event_id!=='string')throw new Error('Reserved event differs from approved sender, recipient or job');return $input.all();"
      }
