        1150,
        0
      ],
      "parameters": {
        "jsCode": "const plan=$('Pinned approved test job').first().json;if($json.n8n_ses!==true||$json.job_id!==plan.job_id)throw new Error('SES test transport is not enabled for pinned job');return [{json:{job_id:plan.job_id}}];"
      }
    },
